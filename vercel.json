{
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": "Product theme 1/frontend/dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/v2/:path*", "destination": "/v2/index.html" },
    { "source": "/v3/:path*", "destination": "/v3/index.html" },
    { "source": "/v4/:path*", "destination": "/v4/index.html" },
    { "source": "/((?!assets|favicon.svg|vite.svg|v2|v3|v4).*)", "destination": "/index.html" }
  ]
}
