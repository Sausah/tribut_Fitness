{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/v2/(.*)", "destination": "/v2/index.html" },
    { "source": "/v3/(.*)", "destination": "/v3/index.html" },
    { "source": "/v4/(.*)", "destination": "/v4/index.html" },
    { "source": "/((?!v2|v3|v4|assets|favicon.svg|vite.svg).*)/?", "destination": "/index.html" }
  ]
}
